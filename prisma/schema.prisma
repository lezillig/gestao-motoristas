generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  GESTOR
  // Acesso restrito ao menu Folha (Afastamentos, Banco de horas, Relatorio
  // anual/mensal, Historico de correcoes) — nao ve cadastros, escalas,
  // convencao, utilizacao/telemetria/combustivel nem analise de riscos.
  FOLHA
  MOTORISTA
}

enum VehicleStatus {
  ATIVO
  MANUTENCAO
  INATIVO
}

// Unidade de valorNumerico por tipo: JORNADA_DIARIA e BANCO_HORAS em horas;
// HORA_EXTRA, ADICIONAL_NOTURNO e TEMPO_ESPERA em percentual; INTERVALO em
// minutos; JORNADA_12X36 e OUTRO usam apenas descricao.
enum TipoRegraConvencao {
  JORNADA_DIARIA
  HORA_EXTRA
  BANCO_HORAS
  ADICIONAL_NOTURNO
  INTERVALO
  JORNADA_12X36
  // Percentual de indenizacao do tempo de espera (art. 235-C, §§8-9, Lei
  // 13.103/2015) — nao e hora extra nem jornada normal, e um adicional a
  // parte sobre a hora normal (minimo legal de 30% quando nao ha regra
  // negociada, ver src/lib/convencao.ts:waitingTimeIndemnityCents).
  TEMPO_ESPERA
  OUTRO
}

// CCT: negociada entre sindicatos (categoria inteira). ACT: negociado direto
// entre o sindicato e esta empresa. Quando os dois existem para o mesmo
// sindicato, o ACT prevalece (art. 620 CLT) — ver src/lib/convencao.ts.
enum TipoConvencao {
  CCT
  ACT
}

// Override individual por motorista — tem precedencia sobre a CCT/ACT do
// sindicato quando definido (art. 59-A CLT permite 12x36 por acordo
// individual, nao so por convencao coletiva). Nulo = segue a CCT/ACT.
enum RegimeHoras {
  PADRAO
  DOZE_X_TRINTA_SEIS
}

// Padrao de folga semanal do motorista, usado para ajustar o limiar do
// alerta de descanso semanal (DSR). Nulo = usa o padrao generico de 7 dias.
enum EscalaSemanal {
  SEIS_UM
  CINCO_DOIS
}

// Titulo financeiro vindo do Omie: RECEBER = contas a receber (faturamento
// do contrato de fretamento), PAGAR = contas a pagar (custo). Os dois vem
// de endpoints diferentes da API do Omie mas tem a mesma forma, por isso
// dividem a mesma tabela (ver model OmieLancamento).
enum OmieTipoLancamento {
  RECEBER
  PAGAR
}

// Recurso do Omie sincronizado por uma execucao (ver model OmieSyncLog).
enum OmieRecurso {
  CLIENTES
  CONTAS_RECEBER
  CONTAS_PAGAR
}

// ---------- Multi-tenant: empresa/cliente ----------
// Mesmo desenho do Sistema Agendamento (ver memoria design-system-agendamento):
// cada empresa e um tenant isolado. Fase 2 roda com uma unica empresa, mas o
// isolamento evita retrabalho se o produto for vendido a mais de um cliente.
model Company {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  sindicatos        Sindicato[]
  drivers           Driver[]
  vehicles          Vehicle[]
  escalas           Escala[]
  timeClockEntries  TimeClockEntry[]
  convencoes        ConvencaoColetiva[]
  regrasConvencao   RegraConvencao[]
  usageLogs         VehicleUsageLog[]
  telemetryReadings TelemetryReading[]
  fuelTransactions  FuelTransaction[]
  consumptionSummaries FuelConsumptionSummary[]
  timeClockCorrections TimeClockCorrection[]
  driverLeaves      DriverLeave[]
  clientes          Cliente[]
  omieLancamentos   OmieLancamento[]
  omieSyncLogs      OmieSyncLog[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  driver             Driver?
  convencoesEnviadas ConvencaoColetiva[]
  omieSyncsExecutados OmieSyncLog[]
}

// ---------- Sindicato / Convencao Coletiva (base para MOD.06, futuro) ----------
// Cadastro do sindicato ja nasce aqui porque o vinculo do motorista a ele e
// pre-requisito do motor de conformidade de convencao coletiva (blueprint
// Fase 1, MOD.06) — mesmo que a CCT em si so seja anexada em fase posterior.
model Sindicato {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  nome      String
  cnpj      String?
  cidade    String?
  estado    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drivers    Driver[]
  convencoes ConvencaoColetiva[]
}

// Cliente/centro de custo — de onde vem a demanda de horas de um contrato
// (ex. "FEMSA Jundiaí", "Mercado Livre", "Fretamento Eventual"). Deliberadamente
// SEPARADO de Driver.departamento (que é texto livre sincronizado
// automaticamente do TiqueTaque, granularidade de rota, sobrescrito a cada
// reimportação) — este cadastro só é mantido pela importação manual da
// planilha financeira de centro de custo, nunca tocado pelo sync do
// TiqueTaque, para não arriscar perder o vínculo silenciosamente.
model Cliente {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  nome      String
  // Janela de horario contratada (HH:mm, texto igual TimeClockEntry.clockIn)
  // — a maioria dos contratos define inicio/fim estimados de operacao, nao
  // um total de horas/mes nem numero de motoristas fixos (confirmado com o
  // usuario). Base para a futura sugestao de headcount: compara a janela
  // exigida pelo contrato contra a hora extra estrutural que os motoristas
  // vinculados a este cliente já estao pagando pra cobri-la.
  horarioInicioContratado String?
  horarioFimContratado    String?
  // Local esperado de marcacao de ponto (endereco do cliente/base) — opcional,
  // usado so pra comparar contra a geolocalizacao das batidas dos motoristas
  // vinculados a este cliente (ver src/lib/pontoCompliance.ts:findClientLocationDivergences).
  // Nenhum motorista/turno e obrigado a ter isso preenchido; sem lat/lon, o
  // cliente so fica de fora dessa checagem especifica, sem quebrar nada.
  latitude  Float?
  longitude Float?
  // ---- Vinculo com o cadastro de clientes do Omie (ERP financeiro) ----
  // `codigo_cliente_omie` e a chave estavel de la; guardado como String (e um
  // inteiro grande no Omie, mas nada aqui faz aritmetica com ele — String
  // evita BigInt, que o Next nao serializa de Server Component pra cliente).
  // Nulo = cliente criado a mao ou pela importacao da planilha de centro de
  // custo, ainda sem par no Omie. O vinculo e feito por CNPJ/CPF quando
  // possivel e so cai pra nome normalizado como ultimo recurso — ver
  // src/lib/omie/sync.ts. Unico por empresa (@@unique abaixo), nao global:
  // cada tenant tem sua propria conta Omie, e nada garante que o codigo 1234
  // de uma seja o mesmo cliente da outra.
  omieCodigoCliente String?
  // CNPJ/CPF so digitos (normalizado) — chave de casamento com o Omie, e dado
  // util por si so no cadastro. Preenchido pelo sync ou manualmente.
  cnpjCpf   String?
  // Razao social e nome fantasia crus do Omie, preservados pra auditoria do
  // vinculo (o `nome` local nao e sobrescrito pelo sync: quem manda no rotulo
  // exibido e o cadastro daqui, que costuma usar o apelido operacional do
  // contrato — ex. "FEMSA Jundiai" — e nao a razao social completa).
  omieRazaoSocial  String?
  omieNomeFantasia String?
  omieSyncedAt     DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  drivers         Driver[]
  omieLancamentos OmieLancamento[]

  @@unique([companyId, nome])
  @@unique([companyId, omieCodigoCliente])
  @@index([companyId, cnpjCpf])
}

// ---------- Motorista ----------
model Driver {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  userId        String?   @unique
  user          User?     @relation(fields: [userId], references: [id])
  sindicatoId   String?
  sindicato     Sindicato? @relation(fields: [sindicatoId], references: [id])
  // Cliente/centro de custo — ver comentário no model Cliente sobre por que
  // isto é separado de `departamento`.
  clienteId     String?
  cliente       Cliente?  @relation(fields: [clienteId], references: [id])
  name          String
  cpf           String    @unique
  // Opcionais: motoristas importados do TiqueTaque (sem dado de CNH) ficam
  // com esses tres campos nulos ate serem completados manualmente — ver
  // src/lib/driverAlerts.ts ("pendente") em vez de tratar como vencida.
  cnh           String?
  cnhCategory   String?
  cnhExpiration DateTime?
  // Data de admissao — opcional (nao vem do TiqueTaque, so cadastro manual).
  // Sem isso o sistema nao consegue calcular periodo aquisitivo/concessivo
  // de ferias, ferias em dobro (art. 137 CLT) nem aviso previo proporcional
  // (Lei 12.506/2011) — motoristas sem esse campo ficam de fora desses
  // calculos especificos, sem travar o resto do cadastro.
  admissao      DateTime?
  phone         String?
  photoUrl      String?
  // Empregador (razao social, resolvida de contract_data.payment_source via
  // GET /payment-sources) e unidade de alocacao/centro de custos do
  // motorista (campo `departamento`, vem de contract_data.department —
  // texto livre do TiqueTaque, so aparado, nao normalizado alem disso; na
  // pratica e a granularidade de contrato/rota, ex. "ESCOLAR - SUL 01" vs
  // "ESCOLAR - SUL 02", nao um departamento de RH) — exibido na UI como
  // "Unidade de alocação" a pedido do usuario. O filtro "Unidade" visto no
  // painel web do TiqueTaque (ex.: AACD, Banco de Alimentos) e um campo
  // DIFERENTE, que nao existe na API publica v2.1 — investigado e
  // confirmado ausente em /employees e em varios endpoints candidatos
  // (todos 404), ver src/lib/tiquetaque/client.ts.
  empregador    String?
  departamento  String?
  // Cargo/funcao real do funcionario no TiqueTaque (contract_data.job_role,
  // ex. "MOTORISTA DE MICRO ONIBUS", "VIGILANTE", "AJUDANTE DE MOTORISTA") —
  // ja era buscado pela integracao (TiqueTaqueEmployee.jobRole, usado so
  // pra filtrar quem importar) mas nao ficava salvo no cadastro.
  funcao        String?
  regimeHoras   RegimeHoras?
  escalaSemanal EscalaSemanal?
  // Valor-hora em centavos (evita float) — usado so para o card de custo
  // de hora extra em /ponto/analise. Nulo = motorista fica de fora da
  // soma de custo (nao trava o calculo dos demais).
  valorHoraCents Int?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  escalas          Escala[]
  timeClockEntries TimeClockEntry[]
  timeClockCorrections TimeClockCorrection[]
  usageLogs        VehicleUsageLog[]
  fuelTransactions FuelTransaction[]
  leaves           DriverLeave[]
}

// Folga/atestado/ferias/abono do motorista, importado do TiqueTaque
// (GET /work-leaves?employee_id=...) — cobre 3 itens do menu "Gestao de
// ponto" do TiqueTaque de uma vez (Escala de folgas, Afastamentos, Ferias),
// que nao tinham fonte nenhuma no sistema ate agora. `tiquetaqueId` guarda
// o _id real de la pra reimportar sem duplicar (mesmo espirito do
// codigoTransacao em FuelTransaction). "Banco de horas" (saldo) e
// "Sobreaviso" NAO tem endpoint publico na API do TiqueTaque — investigado
// e confirmado ausente, ver src/lib/tiquetaque/client.ts.
model DriverLeave {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  driverId     String
  driver       Driver   @relation(fields: [driverId], references: [id])
  tiquetaqueId String?  @unique
  // Texto cru do TiqueTaque: "folga" | "atestado" | "ferias" | "abono" —
  // nao normalizado pra enum de proposito, caso apareçam outros valores no
  // futuro que a gente ainda nao viu na base real.
  leaveType    String
  startDate    DateTime
  endDate      DateTime
  details      String?
  paidLeave    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, startDate])
  @@index([driverId, startDate])
}

// ---------- Veiculo ----------
model Vehicle {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id])
  plate     String        @unique
  brand     String
  model     String
  year      Int
  type      String
  status    VehicleStatus @default(ATIVO)
  // Atualizado a cada encerramento de VehicleUsageLog (checkout com km final).
  currentMileage         Int @default(0)
  // Marca o km em que a ultima manutencao foi registrada; a diferenca para
  // currentMileage alimenta o alerta de manutencao pendente em /utilizacao.
  lastMaintenanceMileage Int @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  escalas           Escala[]
  usageLogs         VehicleUsageLog[]
  telemetryReadings TelemetryReading[]
  fuelTransactions  FuelTransaction[]
  consumptionSummaries FuelConsumptionSummary[]
}

// ---------- Escala (MOD.02) ----------
// Turno planejado: motorista + veiculo + janela de horario em uma data. A
// checagem de conflito (mesmo motorista ou mesmo veiculo com horario
// sobreposto) roda em src/lib/escalaConflicts.ts antes de criar/editar.
model Escala {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  date      DateTime
  startTime String // HH:mm
  endTime   String // HH:mm
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usageLogs VehicleUsageLog[]

  @@index([companyId, date])
}

// ---------- Ponto (MOD.03) ----------
// Um registro por dia trabalhado (entrada/saida), no molde do TimeClockEntry
// do Sistema Agendamento. clockOut fica nulo enquanto o turno esta aberto. As
// checagens de hora extra e interjornada (Lei 13.103/2015, art. 235-C/235-D)
// rodam em src/lib/pontoCompliance.ts a partir destes registros.
model TimeClockEntry {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  date      DateTime
  clockIn   String // HH:mm
  clockOut  String? // HH:mm, nulo enquanto o turno esta aberto
  // Pausa dentro do turno (intervalo intrajornada, art. 71 CLT). Opcionais
  // para nao invalidar registros antigos — ausencia dos dois em turnos
  // longos e o que alimenta o alerta de "intervalo nao registrado".
  intervaloInicio String? // HH:mm
  intervaloFim    String? // HH:mm
  // Tempo de espera (art. 235-C, §§8-9, Lei 13.103/2015): motorista parado
  // aguardando carga/descarga ou embarque/desembarque — NAO e jornada normal
  // nem hora extra, e indenizado a parte (percentual sobre a hora normal,
  // minimo legal 30%). Opcionais, so lancamento manual (a API do TiqueTaque
  // nao distingue esse tipo de pausa das demais) — ver
  // src/lib/pontoCompliance.ts:waitingMinutes.
  esperaInicio String? // HH:mm
  esperaFim    String? // HH:mm
  // Lista ordenada de pares {entrada, saida} do dia — so populado pra
  // importacao TiqueTaque (a API devolve batidas avulsas, sem rotulo de
  // entrada/saida, so pareaveis por ordem cronologica; um dia pode ter mais
  // de 1 intervalo, o que os dois campos acima nao conseguem representar).
  // Quando presente, e a fonte de verdade pro calculo de horas trabalhadas
  // (soma de cada par fechado) em vez do span bruto clockIn->clockOut — ver
  // src/lib/pontoCompliance.ts:workedMinutes. Nulo para lancamento manual
  // (um unico intervalo, os campos acima bastam).
  punches   Json?
  // Origem do registro: nulo para lancamento manual, "TIQUETAQUE" quando
  // veio da importacao via API de batidas avulsas (pareamento heuristico,
  // ver src/lib/tiquetaque/pairing.ts), "TIQUETAQUE_CSV" quando veio da
  // planilha oficial de exportacao em massa (pareamento decidido pelo
  // proprio TiqueTaque, mais confiavel — ver
  // src/lib/tiquetaque/csvImport.ts). Nunca sobrescreve um lancamento
  // manual; entre as duas fontes automaticas, CSV pode corrigir API mas
  // API nunca sobrescreve CSV — ver overwritableFontes em
  // src/lib/tiquetaque/importCore.ts:reconcileDriverDays.
  fonte     String?
  notes     String?
  // Hash SHA-256 (hex) do conteudo atual do registro (horarios, intervalo,
  // espera, punches) — ver src/lib/integrity.ts:hashPontoState. Atualizado
  // a cada escrita feita pelo app (criacao/edicao). Permite ao "dossie"
  // (relatorio de auditoria, /ponto/correcoes) recomputar o hash a partir
  // dos campos atuais e comparar com este valor: uma divergencia indica que
  // o registro foi alterado por fora do fluxo normal do app (ex.: script
  // direto no banco), sem passar pelo log de TimeClockCorrection abaixo.
  hashAtual String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  corrections TimeClockCorrection[]

  @@index([companyId, date])
  @@index([driverId, date])
}

// Historico append-only de alteracoes em TimeClockEntry — trilha de
// auditoria com valor probatorio (o que decide valor probatorio em juizo
// nao e so o calculo estar certo, e a integridade VERIFICAVEL do registro:
// quem alterou, quando, o que mudou, por que). Cobre 3 origens: (1)
// reimportacao do TiqueTaque encontrando um TimeClockEntry ja existente com
// horarios diferentes (a correcao foi feita direto no TiqueTaque, nao aqui
// — ver importCore.ts); (2) edicao manual via updateEntry, quando o
// conteudo realmente muda; (3) exclusao manual via deleteEntry — preserva o
// estado "antes" completo mesmo depois do TimeClockEntry ser removido
// (`entryId` fica null nesse caso, `onDelete: SetNull` em vez de Cascade,
// de proposito: apagar o registro NAO PODE apagar seu proprio historico de
// auditoria, senao a trilha perde sentido). Nunca atualizada/apagada
// depois de criada — e a base do relatorio /ponto/correcoes e do "dossie"
// de defesa por motorista.
model TimeClockCorrection {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  entryId   String?
  entry     TimeClockEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  date      DateTime // data do turno corrigido, para listar/filtrar sem join

  // "TIQUETAQUE_REIMPORT" | "TIQUETAQUE_CSV_IMPORT" | "EDICAO_MANUAL" |
  // "EXCLUSAO_MANUAL" — texto livre (nao enum) pra nao precisar de
  // migration toda vez que uma nova origem for adicionada, mesmo padrao ja
  // usado em TimeClockEntry.fonte.
  origem           String @default("TIQUETAQUE_REIMPORT")
  // Quem fez a alteracao — so preenchido pra edicao/exclusao manual (a
  // reimportacao do TiqueTaque reflete uma mudanca feita por outra pessoa,
  // fora deste sistema; nao ha um usuario "daqui" pra atribuir).
  editadoPorUserId String?
  motivo           String?

  clockInAntes         String
  clockOutAntes         String?
  intervaloInicioAntes String?
  intervaloFimAntes    String?
  punchesAntes         Json?

  // Nulos na linha de EXCLUSAO_MANUAL — nao ha um "depois", o registro foi
  // removido.
  clockInDepois         String?
  clockOutDepois         String?
  intervaloInicioDepois String?
  intervaloFimDepois    String?
  punchesDepois         Json?

  // Hash (ver TimeClockEntry.hashAtual) do estado antes/depois desta
  // alteracao — permite verificar a cadeia: hashDepois desta linha deve
  // bater com o hashAntes da proxima correcao do mesmo registro, ou com o
  // hashAtual do TimeClockEntry se for a mais recente. Nulo em linhas
  // antigas, criadas antes deste campo existir — tratado como "nao
  // verificavel", nunca como "violado".
  hashAntes String?
  hashDepois String?

  corrigidoEm DateTime @default(now())

  @@index([companyId, corrigidoEm])
  @@index([driverId, date])
}

// ---------- Convencao Coletiva (MOD.06) ----------
// PDF da CCT vigente de um sindicato. "Vigente" e calculado em runtime a
// partir de vigenciaInicio/vigenciaFim (sem campo de status para nao ficar
// desatualizado). As regras extraidas ficam em RegraConvencao — hoje via
// formulario estruturado manual; a extracao assistida por IA fica para a
// Fase 3, apos termos volume real de CCTs cadastradas.
model ConvencaoColetiva {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  sindicatoId    String
  sindicato      Sindicato @relation(fields: [sindicatoId], references: [id])
  tipo           TipoConvencao @default(CCT)
  fileName       String
  fileUrl        String
  vigenciaInicio DateTime
  vigenciaFim    DateTime?
  uploadedById   String
  uploadedBy     User     @relation(fields: [uploadedById], references: [id])
  uploadedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  regras RegraConvencao[]

  @@index([sindicatoId])
}

model RegraConvencao {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id])
  convencaoId   String
  convencao     ConvencaoColetiva  @relation(fields: [convencaoId], references: [id], onDelete: Cascade)
  tipo          TipoRegraConvencao
  valorNumerico Float?
  descricao     String?
  createdAt     DateTime           @default(now())
}

// ---------- Utilizacao de veiculos (MOD.04) ----------
// Uso real do veiculo por um motorista, distinto da Escala (planejamento).
// Comparar escalaId nulo num periodo com escala vs. uso sem escala e o que
// alimenta o alerta de divergencia em /utilizacao. Ao encerrar (checkOutAt +
// kmFinal preenchidos), a action atualiza Vehicle.currentMileage.
model VehicleUsageLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id])
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  escalaId   String?
  escala     Escala?  @relation(fields: [escalaId], references: [id])
  checkInAt  DateTime
  checkOutAt DateTime?
  kmInicial  Int
  kmFinal    Int?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId, checkInAt])
}

// ---------- Telemetria / velocidade (MOD.05) ----------
// Leitura normalizada, independente do fornecedor de origem (campo
// "provider" e so informativo). Hoje alimentada por MockTelemetryProvider
// (src/lib/telemetry); trocar para a API real da Ituran no futuro nao exige
// mudar este modelo, so o adapter que grava aqui. Excesso de velocidade e
// calculado em runtime (src/lib/speedCompliance.ts), nao persistido, no
// mesmo padrao do motor de conformidade de ponto.
model TelemetryReading {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  speedKmh   Float
  latitude   Float
  longitude  Float
  provider   String
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@index([vehicleId, recordedAt])
}

// ---------- Combustivel (MOD.07) ----------
// Uma linha por transacao de abastecimento importada da planilha de extrato
// do cartao Ticket Log (nao ha API de consulta do lado cliente-frota hoje,
// so a de recolha de notas do lado posto — ver src/app/(app)/combustivel/
// actions.ts). vehicleId/driverId ficam nulos quando a placa/motorista da
// planilha nao bate com nenhum cadastro — a transacao ainda e importada
// (visibilidade financeira), so fica marcada como "sem vinculo" na UI.
// placaOriginal/motoristaOriginal preservam o texto cru pra auditoria mesmo
// sem match.
model FuelTransaction {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  vehicleId         String?
  vehicle           Vehicle? @relation(fields: [vehicleId], references: [id])
  driverId          String?
  driver            Driver?  @relation(fields: [driverId], references: [id])
  dataHora          DateTime
  valorCents        Int
  volumeLitros      Float
  combustivel       String?
  posto             String?
  cidade            String?
  uf                String?
  hodometro         Int?
  kmRodados         Int?
  numeroAutorizacao String?
  // Codigo real e estavel do sistema de origem (coluna "CODIGO TRANSACAO"
  // do extrato real RFCV) — quando presente, e o criterio de duplicata
  // (muito mais confiavel que a heuristica de tempo+valor usada pro
  // template manual, que nao tem esse codigo).
  codigoTransacao   String?  @unique
  placaOriginal     String
  motoristaOriginal String?
  // Texto cru da coluna "MODELO VEICULO" do extrato real (RFCV) — mesma
  // filosofia de placaOriginal/motoristaOriginal: a maioria das transacoes
  // nao tem vehicleId vinculado ainda (cadastro de veiculos local incompleto
  // frente a frota real), entao a UI usa vehicle?.model ?? modeloOriginal.
  modeloOriginal    String?
  createdAt         DateTime @default(now())

  @@index([companyId, dataHora])
  @@index([vehicleId, dataHora])
}

// Preco medio de revenda por UF/produto, direto do "Levantamento Semanal
// de Precos" da ANP (arquivo publico, sem login, ver src/lib/anp/client.ts).
// Deliberadamente SEM companyId — e dado de referencia publico, igual pra
// qualquer empresa, ao contrario de todo o resto do schema (excecao
// consciente ao padrao multi-tenant). Preenchido sob demanda por
// syncAnpPrices (src/app/(app)/combustivel/actions.ts), nunca automatico a
// cada carregamento de pagina, pra nao arriscar timeout com varios fetches
// externos numa unica renderizacao.
model AnpPrecoReferencia {
  id              String   @id @default(cuid())
  uf              String
  produto         String
  semanaInicio    DateTime
  semanaFim       DateTime
  precoMedioCents Int
  createdAt       DateTime @default(now())

  @@unique([uf, produto, semanaInicio])
  @@index([semanaInicio])
}

// Uma linha por veiculo x contrato x combustivel x periodo, direto do
// "Relatorio Resumido de Consumo" do sistema de frota do usuario — um HTML
// disfarçado de .xls (nao e Excel de verdade), agregado pro periodo
// inteiro, sem data de abastecimento individual nem motorista (por isso e
// um model separado de FuelTransaction, nao a mesma tabela). "Contrato" e
// o cliente da AzulMob (ex. "FEMSA JUNDIAI", "ESCOLAR SP") — fica como
// texto livre aqui, deliberadamente NAO promovido a campo do Veiculo por
// enquanto (a lista varia muito mes a mes, alguns meses so tem "ND").
// vehicleId nulo quando a placa nao bate com o cadastro — mesma filosofia
// de FuelTransaction (visibilidade financeira antes de vinculo estrito).
model FuelConsumptionSummary {
  id                   String   @id @default(cuid())
  companyId            String
  company              Company  @relation(fields: [companyId], references: [id])
  vehicleId            String?
  vehicle              Vehicle? @relation(fields: [vehicleId], references: [id])
  placaOriginal        String
  contrato             String
  tipoCombustivel      String
  // Coluna "Ultima Km e/ou H" do relatorio — parte da chave de identidade
  // da linha (nao so complemento). O mesmo veiculo/contrato/combustivel
  // pode aparecer 2x legitimamente no mesmo periodo (2 leituras/lotes
  // distintos); sem este campo na constraint unica, o createMany com
  // skipDuplicates descarta a segunda linha como se fosse reimportacao —
  // bug real encontrado testando dados de producao (perdeu R$1.694,94 de
  // um mes real antes deste campo ser incluido).
  ultimoKmOuHora       Float?
  periodoInicio        DateTime
  periodoFim           DateTime
  kmRodados            Int?
  horasTrabalhadas     Float?
  litros               Float
  valorMedioLitroCents Int?
  kmPorLitro           Float?
  litrosPorHora        Float?
  totalCents           Int
  createdAt            DateTime @default(now())

  @@unique([companyId, placaOriginal, contrato, tipoCombustivel, periodoInicio, periodoFim, ultimoKmOuHora])
  @@index([companyId, periodoInicio])
}
// ---------- Integracao Omie (ERP financeiro) ----------
// Titulo financeiro espelhado do Omie (contas a receber e a pagar, mesma
// forma, endpoints diferentes — ver src/lib/omie/financeiro.ts). Espelho de
// LEITURA: este sistema nunca escreve no Omie, quem manda no dado financeiro
// continua sendo o ERP. O valor de trazer isso pra ca e cruzar receita por
// cliente/contrato com o custo de mao de obra que o sistema ja calcula
// (hora extra estrutural por cliente, ver Cliente e src/lib/pontoCompliance.ts)
// — comparacao que hoje ninguem consegue fazer sem exportar planilha dos dois
// lados.
//
// Valores em centavos (Int) pelo mesmo motivo do resto do schema (valorCents
// em FuelTransaction, valorHoraCents em Driver): a API do Omie devolve float
// e float nao fecha centavo em soma de milhares de titulos.
model OmieLancamento {
  id                          String             @id @default(cuid())
  companyId                   String
  company                     Company            @relation(fields: [companyId], references: [id])
  tipo                        OmieTipoLancamento
  // `codigo_lancamento_omie` — chave estavel do titulo no Omie, criterio de
  // duplicata do sync (mesma filosofia de codigoTransacao em FuelTransaction
  // e tiquetaqueId em DriverLeave). E unico por tipo, nao globalmente: um
  // titulo a pagar e um a receber podem ter o mesmo numero.
  omieCodigoLancamento        String
  // Cliente local vinculado — nulo quando o cliente/fornecedor do titulo nao
  // tem par no cadastro daqui (fornecedores, na pratica, quase nunca tem).
  // Mesma filosofia de FuelTransaction: o titulo e importado do mesmo jeito
  // (visibilidade financeira antes de vinculo estrito) e os campos crus
  // abaixo preservam a identidade da outra ponta pra auditoria.
  clienteId                   String?
  cliente                     Cliente?           @relation(fields: [clienteId], references: [id])
  omieCodigoClienteFornecedor String?
  nomeClienteFornecedor       String?
  cnpjCpfClienteFornecedor    String?

  numeroDocumento    String?
  // Categoria/departamento/projeto do Omie (codigos crus). Departamento no
  // Omie e o centro de custo do ERP — NAO e o Driver.departamento vindo do
  // TiqueTaque (que e granularidade de rota); nomes iguais, dominios
  // diferentes, por isso nada aqui tenta casar os dois automaticamente.
  codigoCategoria    String?
  codigoDepartamento String?
  codigoProjeto      String?

  dataEmissao    DateTime?
  dataVencimento DateTime
  // Data da baixa (pagamento/recebimento efetivo). Nula enquanto em aberto.
  dataPagamento  DateTime?
  valorCents     Int
  valorPagoCents Int?
  // `status_titulo` cru do Omie ("ATRASADO", "A VENCER", "RECEBIDO", "PAGO",
  // "CANCELADO"...) — texto livre, nao enum, pra nao precisar de migration
  // quando o ERP introduzir um status novo (mesmo padrao ja usado em
  // TimeClockEntry.fonte e TimeClockCorrection.origem).
  status         String?
  observacao     String?
  // Ultima vez que o sync tocou esta linha — um titulo pode mudar no Omie
  // depois de importado (baixa, cancelamento, alteracao de valor) e o sync
  // reescreve o registro; este campo diz quao fresco o espelho esta.
  syncedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, tipo, omieCodigoLancamento])
  @@index([companyId, dataVencimento])
  @@index([clienteId, dataVencimento])
}

// Historico de execucoes do sync com o Omie — uma linha por recurso por
// execucao (manual ou cron). Existe pelo mesmo motivo de TimeClockCorrection
// existir: quando um numero financeiro aparece diferente do ERP, a primeira
// pergunta e "quando isso foi sincronizado pela ultima vez e o que entrou",
// e sem registro a resposta e chute. Tambem e o que a tela /integracoes usa
// pra mostrar o estado da integracao sem chamar a API do Omie a cada
// carregamento de pagina (a API tem bloqueio por consumo indevido — ver
// src/lib/omie/client.ts).
model OmieSyncLog {
  id                 String      @id @default(cuid())
  companyId          String
  company            Company     @relation(fields: [companyId], references: [id])
  recurso            OmieRecurso
  // "MANUAL" | "CRON" — texto livre pelo mesmo motivo dos demais campos de
  // origem do schema.
  origem             String      @default("MANUAL")
  executadoPorUserId String?
  executadoPor       User?       @relation(fields: [executadoPorUserId], references: [id])
  // Janela consultada, quando o recurso aceita filtro por data (contas a
  // pagar/receber). Nula pro sync de clientes, que e sempre integral.
  periodoInicio      DateTime?
  periodoFim         DateTime?

  criados      Int     @default(0)
  atualizados  Int     @default(0)
  // Registros lidos do Omie que nao viraram/atualizaram linha nenhuma aqui
  // (ex.: cliente do Omie sem par no cadastro local e sem criacao automatica).
  ignorados    Int     @default(0)
  paginasLidas Int     @default(0)
  // A leitura parou antes do fim por falta de orcamento de tempo (teto de 60s
  // da funcao na Vercel). Nao e erro — o que entrou esta correto, so esta
  // incompleto — mas precisa aparecer no historico, senao uma execucao parcial
  // passa por completa e a proxima pergunta ("por que falta titulo de maio?")
  // fica sem resposta.
  interrompido Boolean @default(false)
  // Mensagem de erro quando a execucao falhou no meio — a linha e gravada
  // do mesmo jeito, com os contadores do que ja tinha entrado antes da
  // falha (o sync grava incrementalmente, nao numa transacao unica).
  erro         String?

  iniciadoEm  DateTime  @default(now())
  concluidoEm DateTime?

  @@index([companyId, iniciadoEm])
}
